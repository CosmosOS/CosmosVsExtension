<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>Cosmos.VisualStudio</RootNamespace>
    <AssemblyName>Cosmos.VisualStudio</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>

    <!-- VSIX packaging -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Visual Studio provides these assemblies at runtime; compile against them only. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <!-- The project system (CPS) the Project Properties pages extend. -->
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem" Version="17.9.380" ExcludeAssets="runtime" />
    <!-- The VSIX build steps (command table, pkgdef, .vsix) only run on Windows.
         Elsewhere the project still compiles, so changes can be checked on Linux or macOS. -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Design" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="CosmosPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="Resources\gdb\cosmos_prettyprint.py">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\CosmosIcon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- SDK-style projects don't pull the VSSDK targets in on their own. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != '' And Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!-- CreatePkgDef loads the assembly and all its types, so it needs Microsoft.Build.Framework,
       whose Rule types the Project Properties pages are made of. It looks for dependencies only
       among the references, where NuGet gives a reference assembly, which can't be loaded:
       hand it the one of the MSBuild doing the build. -->
  <Target Name="AddMSBuildFrameworkForPkgDef" BeforeTargets="GeneratePkgDef">
    <ItemGroup>
      <CreatePkgDefReferencedAssemblies Include="$(MSBuildToolsPath)\Microsoft.Build.Framework.dll" />
    </ItemGroup>
  </Target>

</Project>
