<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Cosmos.VisualStudio.77e2f7e6-2f56-45de-9e83-82ec60bed79b" Version="1.1.0" Language="en-US" Publisher="cosmosos" />
    <DisplayName>Cosmos OS Development</DisplayName>
    <Description>Create, build, run and debug Cosmos gen3 kernels — bare-metal C# compiled with NativeAOT — in QEMU, with live kernel thread, GC and memory views.</Description>
    <MoreInfo>https://github.com/CosmosOS/CosmosVsExtension</MoreInfo>
    <License>Resources\LICENSE.txt</License>
    <Icon>Resources\CosmosIcon.png</Icon>
    <PreviewImage>Resources\CosmosIcon.png</PreviewImage>
    <Tags>cosmos, kernel, os, nativeaot, bare-metal, debugger, qemu, gdb</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <!-- The project system parts behind the Cosmos pages of Project Properties. -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
  </Assets>
</PackageManifest>
