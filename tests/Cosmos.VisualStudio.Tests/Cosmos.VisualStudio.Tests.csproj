<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The extension's Core folder has no Visual Studio dependency, so it is
         compiled straight into the tests and runs on any OS. -->
    <Compile Include="..\..\src\Cosmos.VisualStudio\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The XamlTypes the Project Properties pages are built from ship only in
         MSBuild's .NET Framework assembly; nothing the tests touch needs more
         of the Framework than .NET provides. -->
    <PackageDownload Include="Microsoft.Build.Framework" Version="[17.14.28]" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(NuGetPackageRoot)microsoft.build.framework/17.14.28/lib/net472/Microsoft.Build.Framework.dll" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
